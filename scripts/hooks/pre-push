#!/usr/bin/env bash
# Segunda rede da trava de vazamento: reescaneia TUDO que este push publicaria.
#
# O pre-commit olha um commit por vez e é pulável (--no-verify, clone sem install-hooks.sh) —
# foi exatamente assim que e-mail interno chegou ao GitHub em 17/08/2026. O push é a fronteira
# de publicação, então aqui a checagem repete sobre o intervalo inteiro que vai sair.
#
# Os padrões são os MESMOS do pre-commit (genéricos aqui + arquivo privado); o formato
# `nome::regex` e os dois caminhos do arquivo privado estão documentados lá — o pre-commit é o
# canônico, este é o cliente compacto.
# Emergência: `git push --no-verify` pula. Saída deliberada, não bug.
set -uo pipefail

# O git entrega os refs uma vez só pelo stdin; guardado numa variável pra o laço não perdê-los se
# algum filho ler daí.
ENTRADA="$(cat)"

PADROES=(
    "chave OpenAI::sk-[A-Za-z0-9_-]{20,}"
    "token GitHub::gh[pousr]_[A-Za-z0-9]{20,}"
    "token GitLab::glpat-[A-Za-z0-9_-]{15,}"
    "chave AWS::AKIA[0-9A-Z]{16}"
    "chave Anthropic::sk-ant-[A-Za-z0-9_-]{20,}"
    "chave privada::BEGIN (RSA|OPENSSH|EC|DSA|PGP) PRIVATE KEY"
    "senha em URL::[a-z]+://[^/[:space:]]+:[^/@[:space:]]{6,}@"
)
_gitdir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
for PRIVADOS in "${XDG_CONFIG_HOME:-$HOME/.config}/git/hooks-padroes-privados" \
                ${_gitdir:+"$_gitdir/hooks-padroes-privados"}; do
    [[ -e "$PRIVADOS" ]] || continue
    if [[ ! -r "$PRIVADOS" ]]; then
        echo "pre-push: $PRIVADOS existe mas não pôde ser lido — trava incompleta, push recusado." >&2
        exit 1
    fi
    while IFS= read -r linha || [[ -n "$linha" ]]; do
        [[ -z "${linha// }" || "$linha" == \#* ]] && continue
        grep -Eq -- "${linha#*::}" </dev/null 2>/dev/null
        if (( $? > 1 )); then
            echo "pre-push: padrão inválido em $PRIVADOS -> ${linha%%::*}" >&2
            exit 1
        fi
        PADROES+=("$linha")
    done < "$PRIVADOS"
done
PADROES+=('IP da tailnet (endereço real de máquina)::100\.(6[5-9]|[7-9][0-9]|1[0-1][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}')

ZERO=0000000000000000000000000000000000000000
achou=0
mudados=""
while read -r _localref localsha _remoteref remotesha; do
    [[ "$localsha" == "$ZERO" ]] && continue          # delete de branch: nada sai
    if [[ "$remotesha" == "$ZERO" ]]; then
        # ponytail: --not --remotes exclui contra TODOS os remotos; com múltiplos remotes, commit
        # já buscado de outro remote escapa da varredura mesmo sendo novo pro alvo. Teto aceito.
        intervalo="$localsha --not --remotes"          # branch nova: só o que o remoto ainda não tem
    else
        intervalo="$remotesha..$localsha"
    fi
    # Só linhas ADICIONADAS pelos commits que vão sair; a própria trava fica de fora (precisa
    # conter os padrões pra procurá-los — mesmo motivo do pre-commit).
    # O git log roda SEPARADO do grep de propósito: num pipe, o `|| true` engolia o erro dele
    # (clone raso, SHA ausente) e "não consegui varrer" virava "nada a escanear" — a trava se
    # desligando calada justamente no clone incompleto. Numa trava, erro de varredura recusa.
    log_saida="$(git log -p --unified=0 --no-color $intervalo -- . \
        ':(exclude)scripts/hooks' ':(exclude)scripts/install-hooks.sh')"
    if (( $? != 0 )); then
        echo "pre-push: não consegui varrer $intervalo — trava incompleta, push recusado." >&2
        exit 1
    fi
    nomes="$(git log --name-only --format= $intervalo -- .)" || {
        echo "pre-push: não consegui listar os arquivos de $intervalo — testes do push não rodariam, push recusado." >&2
        exit 1
    }
    mudados+="$nomes"$'\n'
    adicionado="$(printf '%s\n' "$log_saida" | grep '^+' | grep -v '^+++' || true)"
    [[ -z "$adicionado" ]] && continue
    for entrada in "${PADROES[@]}"; do
        # 1 = sem achado; 2+ = o grep FALHOU, e varredura quebrada não pode passar como limpa.
        casadas="$(printf '%s\n' "$adicionado" | grep -Ei -- "${entrada#*::}")"; rc=$?
        if (( rc >= 2 )); then
            echo "pre-push: a varredura falhou (grep saiu com $rc) no padrão ${entrada%%::*}" >&2
            exit 1
        fi
        if [[ -n "$casadas" ]]; then
            achou=1
            printf '\n  \033[31m%s\033[0m  (em %s)\n' "${entrada%%::*}" "$intervalo"
            printf '%s\n' "$casadas" | head -5 | sed 's/^+/    /' | cut -c1-140
        fi
    done
done <<< "$ENTRADA"

if (( achou )); then
    cat >&2 <<'FIM'

  ── push recusado: isto publicaria num repositório PÚBLICO ─────────────────

  O que está acima está em commits que este push mandaria pro remoto.
  Conserte o commit (rebase/amend) ou, se for falso positivo com certeza:
  git push --no-verify

FIM
    exit 1
fi

# Só os testes ligados ao que o push leva. A suíte inteira NÃO roda aqui: com várias sessões
# trabalhando ela derruba a máquina e estoura tempo, e o pytest completo fecha as sessões sem
# terminal. Quem julga a suíte inteira é o ci.yml; `scripts/ci-gates.sh` roda à mão.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
raiz="$(git rev-parse --show-toplevel)" || exit 1
cd "$raiz" || exit 1

front=(); core=(); back=()
while IFS= read -r f; do
    [[ -n "$f" && -e "$f" ]] || continue
    case "$f" in
        packages/core/src/*.ts) core+=("$raiz/$f"); front+=("$raiz/$f") ;;
        frontend/src/paraglide/*) ;;
        frontend/src/*.ts|frontend/src/*.js|frontend/src/*.svelte) front+=("$raiz/$f") ;;
        backend/tests/test_*.py) back+=("${f#backend/}") ;;
        backend/app/*.py)
            nome="$(basename "$f" .py)"
            for t in backend/tests/test_"$nome".py backend/tests/test_"$nome"_*.py; do
                [[ -e "$t" ]] && back+=("${t#backend/}")
            done ;;
    esac
done < <(printf '%s' "$mudados" | sort -u)

total=$(( ${#core[@]} + ${#front[@]} + ${#back[@]} ))
if (( total == 0 )); then
    exit 0
fi
# PERGUNTA, não roda sozinho: rodar em todo push cobrava minutos de quem só queria enviar. Sem
# terminal pra perguntar — sessão de agente, script, CI, e também cliente gráfico de git, que sobe
# o hook sem pty — a resposta é NÃO e o push segue; quem julga tudo é o ci.yml. Querendo os testes
# nesse caso, rode `scripts/ci-gates.sh` à mão.
resposta=""
if { exec 3</dev/tty; } 2>/dev/null; then
    read -r -t 60 -u 3 -p \
        "pre-push: rodar os testes ligados aos ${total} arquivo(s) que vão subir? [s/N] " resposta
    exec 3<&-
    echo >&2
else
    echo "pre-push: sem terminal pra perguntar (agente, script ou cliente gráfico) — testes dos ${total} arquivo(s) PULADOS; o ci.yml julga, ou rode scripts/ci-gates.sh" >&2
fi
case "${resposta:-n}" in
    s|S|y|Y) ;;
    *) exit 0 ;;
esac

falhou=()
if (( ${#core[@]} )); then
    echo "pre-push: vitest dos arquivos de @hangar/core que vão subir…" >&2
    (cd packages/core && flock -w 900 /tmp/hangar-verificacao.lock \
        npx --no-install vitest related --run --passWithNoTests "${core[@]}") || falhou+=("vitest @hangar/core")
fi
if (( ${#front[@]} )); then
    echo "pre-push: vitest dos arquivos do front que vão subir…" >&2
    if (cd frontend && npm run --silent i18n:compile >/dev/null); then
        (cd frontend && flock -w 900 /tmp/hangar-verificacao.lock \
            npx --no-install vitest related --run --passWithNoTests "${front[@]}") || falhou+=("vitest frontend")
    else
        falhou+=("i18n:compile do frontend (vitest não rodou)")
    fi
fi
if (( ${#back[@]} )); then
    mapfile -t back < <(printf '%s\n' "${back[@]}" | sort -u)
    echo "pre-push: pytest de ${#back[@]} arquivo(s) de teste ligados ao que vai subir…" >&2
    (cd backend && uv run pytest -q "${back[@]}") || falhou+=("pytest backend")
fi

if (( ${#falhou[@]} )); then
    cat >&2 <<FIM

  ── push recusado: testes ligados ao que vai subir falharam ────────────────
  Falhou: ${falhou[*]}
  Corrija e tente de novo. Emergência, sabendo o que está fazendo:
  git push --no-verify

FIM
    exit 1
fi
exit 0
